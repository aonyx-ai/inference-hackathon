classDiagram
  direction LR
  namespace ScopingContext {
  class Session {
    <<AggregateRoot>>
    +SessionId id 🔑
    +string goal
    +ChatMessage[] conversation
    +Artifact[] artifacts
    +Decision[] decisions
    +ActivityEvent[]? activity
    +Plan? plan
  }
  class ChatMessage {
    <<Entity>>
    +string id 🔑
    +Author author
    +string text
    +Timestamp at
  }
  class Decision {
    <<Entity>>
    +string id 🔑
    +ArtifactId artifactId
    +ArtifactKind from
    +string question
    +bool resolved
  }
  class ActivityEvent {
    <<Entity>>
    +string id 🔑
    +ActivityKind kind
    +ArtifactKind? from
    +ArtifactId? artifactId
    +string? decisionId
    +string text
    +bool? pending
    +Timestamp at
  }
  class Plan {
    <<ValueObject>>
    +string overview
    +PlanStep[] steps
  }
  class PlanStep {
    <<ValueObject>>
    +string title
    +string detail
  }
  }
  namespace ArtifactContext {
  class Artifact {
    <<AggregateRoot>>
    +ArtifactId id 🔑
    +ArtifactKind kind
    +string title
    +string summary
    +ArtifactStatus status
    +ChatMessage[] conversation
    +ArtifactBody body
    +string? staleReason
    +string? openQuestion
  }
  class ArtifactBody {
    <<union>>
    +BodyType type
  }
  class GraphBody {
    <<Entity>>
    +BodyType type
    +GraphNode[] nodes
    +GraphEdge[] edges
  }
  class WireframeBody {
    <<Entity>>
    +BodyType type
    +string screen
    +WireframeNode[] nodes
  }
  class DesignBody {
    <<Entity>>
    +BodyType type
    +DesignScene before
    +DesignScene after
    +TokenDelta[]? tokens
  }
  class GraphNode {
    <<ValueObject>>
    +string id 🔑
    +string label
    +string? group
    +Change? change
  }
  class GraphEdge {
    <<ValueObject>>
    +string from
    +string to
    +string? label
    +Change? change
  }
  class WireframeNode {
    <<ValueObject>>
    +string id 🔑
    +string label
    +WireframeNodeKind kind
    +int col
    +int row
    +int width
    +int height
    +Change? change
  }
  class DesignScene {
    <<ValueObject>>
    +string screen
    +UiNode root
  }
  class UiNode {
    <<ValueObject>>
    +string id 🔑
    +UiComponent component
    +StringMap? props
    +UiNode[]? children
    +Change? change
  }
  class TokenDelta {
    <<ValueObject>>
    +string name
    +string before
    +string after
  }
  }
  Session *-- "*" ChatMessage : conversation
  Session *-- "*" Artifact : artifacts
  Session *-- "*" Decision : decisions
  Session *-- "*" ActivityEvent : activity
  Session *-- "0..1" Plan : plan
  Plan *-- "*" PlanStep : steps
  Artifact *-- "*" ChatMessage : conversation
  Artifact *-- "1" ArtifactBody : body
  ArtifactBody <|-- GraphBody
  ArtifactBody <|-- WireframeBody
  ArtifactBody <|-- DesignBody
  GraphBody *-- "*" GraphNode : nodes
  GraphBody *-- "*" GraphEdge : edges
  WireframeBody *-- "*" WireframeNode : nodes
  DesignBody *-- "1" DesignScene : before
  DesignBody *-- "1" DesignScene : after
  DesignBody *-- "*" TokenDelta : tokens
  DesignScene *-- "1" UiNode : root
  UiNode *-- "*" UiNode : children
  Decision --> "1" Artifact : artifactId
  ActivityEvent --> "0..1" Artifact : artifactId
  ActivityEvent --> "0..1" Decision : decisionId
  note for Session "An orchestrator turns the developer's goal into a Session, then spawns one artifact agent per surface: architecture, domain, and ux"
  note for Artifact "Holds one surface's work; stale sets staleReason, needs-input sets openQuestion"
  note for ArtifactBody "Tagged union on type; architecture and domain render as a GraphBody, ux as a WireframeBody or DesignBody"
  note for ChatMessage "author is the user, the orchestrator, or an ArtifactKind"
  note for Decision "An agent raises a Decision up to the orchestrator for the developer to settle"
  note for ActivityEvent "A durable trace of background work; pending is true while it runs, false once it lands"
  note for Plan "Synthesized once scoping is marked done; absent until then, regenerating replaces it"
  note for UiNode "props is a string-to-string map; component is a closed vocabulary that falls back to a labeled box"

# Copy this file to `.env` and fill in your own keys. Bun loads `.env`
# automatically, so the values become available as environment variables.
# Never commit the real `.env` — it is gitignored.

# Nebius AI Studio API key, used for inference against Nebius-hosted models.
NEBIUS_API_KEY=

# Anthropic API key, used for Claude models in the agent runtime.
ANTHROPIC_API_KEY=

# Optional overrides for the orchestrator agent. It runs on Anthropic by default;
# set ORCHESTRATOR_PROVIDER=nebius to drive it with a Nebius-hosted model instead.
# ORCHESTRATOR_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# The repo-research agents always run on a Nebius-hosted Nemotron model, since
# the fan-out over the codebase wants a cheap, tool-using open model. Override
# the default (nvidia/Nemotron-3-Ultra-550b-a55b) here.
# NEBIUS_RESEARCH_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional port for the planner server the webview proxies to (defaults to 8787).
# PLANNER_PORT=8787
